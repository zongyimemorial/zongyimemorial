# ===== 数据库（本地用 Docker PostgreSQL；生产用云 RDS）=====
DATABASE_URL="postgresql://memorial:memorial@localhost:5432/memorial?schema=public"

# ===== Auth.js v5 =====
# 生成：openssl rand -base64 32
AUTH_SECRET="change-me-in-production-please-use-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ===== 站点 =====
NEXT_PUBLIC_SITE_NAME="云纪念 · 殡葬祭祀文化平台"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ===== 短信 OTP（预留，接阿里云/腾讯云短信）=====
SMS_ACCESS_KEY=""
SMS_SECRET=""
SMS_SIGN=""
SMS_TEMPLATE=""

# ===== 邮件 SMTP（找回密码验证码 / 系统通知，上线必填）=====
# 二选一：配置 SMTP_* 走通用 SMTP，或配置 RESEND_API_KEY 走 Resend 网关。
# 两者都留空 → 自动降级 mock（验证码仅打印服务端日志并回显页面），仅限内测。
#
# —— 方案 A：通用 SMTP（腾讯企业邮 / 阿里云邮件推送 / 网易 / QQ / Gmail 等）——
# SMTP_HOST="smtp.exmail.qq.com"          # 发信服务器地址
# SMTP_PORT="465"                         # 465=SSL；587/25 通常配 SMTP_SECURE=false 走 STARTTLS
# SMTP_SECURE="true"                      # 端口 465 用 true；587 用 false
# SMTP_USER="noreply@zongyimemorial.com"
# SMTP_PASS="your-smtp-password-or-auth-code"   # 部分邮箱需填「授权码」而非登录密码
# SMTP_FROM="宗忆堂 <noreply@zongyimemorial.com>"  # 发件人显示名+地址
#
# —— 方案 B：Resend（推荐，海外送达率高、与 Next.js 契合）——
# RESEND_API_KEY="re_xxxxxxxxxxxx"
# SMTP_FROM="宗忆堂 <onboarding@yourdomain.com>"   # Resend 须已验证发信域名
#
# 验证发信用收件人（可选）：node scripts/verify-smtp.mjs 会把测试信发到该地址
# MAIL_TEST_TO="you@example.com"

# ===== 支付（M3 接入；当前用 SIMULATE 兜底）=====
PAY_CHANNEL="SIMULATE"
WECHAT_MCH_ID=""
WECHAT_APP_ID=""
WECHAT_API_KEY=""
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""

# ===== AI 对话层（LLM）=====
# DeepSeek 为主要对话模型；留空则自动回退 Mock（本地演示全流程可用）
DEEPSEEK_API_KEY=""
# 火山方舟 / 豆包（ark- 开头的 Key）；填了优先于 DeepSeek，否则回退 Mock。
# 模型默认 doubao-seed-character-260628（人设对话），可在 ARK_MODEL 覆盖。
ARK_API_KEY=""
ARK_MODEL="doubao-seed-character-260628"
# 复杂人格推演攻坚用，可选；留空不影响主链路
ANTHROPIC_API_KEY=""

# ===== AI 语音层（ASR + TTS，火山引擎 / 豆包）=====
# 在火山引擎控制台开通「语音技术」后获取；两项都填齐才会启用真实语音，否则回退 Mock。
# 参考：https://www.volcengine.com/docs/6561
VOLCANO_APP_ID=""
VOLCANO_ACCESS_TOKEN=""
# TTS 集群标识，默认 volcano_tts；声音复刻/大模型语音另见控制台开通的 cluster 名
VOLCANO_CLUSTER="volcano_tts"

# 自建 CosyVoice 3（可选，Apache 2.0）：填了则 TTS 优先走自建，成本远低于云 API。
# 格式为完整推理接口地址，例如 http://cosyvoice.internal:9880/tts
COSYVOICE_ENDPOINT=""

# ===== 对象存储（COS/OSS，M4 接入）=====
OSS_REGION=""
OSS_BUCKET=""
OSS_ACCESS_KEY=""
OSS_SECRET=""

# ===== 第三方 OAuth 登录 =====
# 微信扫码登录（开放平台网站应用，与微信支付的 WECHAT_APP_ID 是不同 AppID）
WECHAT_OAUTH_APP_ID=""
WECHAT_OAUTH_APP_SECRET=""
# QQ 登录（QQ 互联）
QQ_APP_ID=""
QQ_APP_SECRET=""
# 抖音登录（抖音开放平台）
DOUYIN_APP_ID=""
DOUYIN_APP_SECRET=""
# 快手登录（快手开放平台）
KUAISHOU_APP_ID=""
KUAISHOU_APP_SECRET=""
# 头条登录（字节跳动开放平台）
TOUTIAO_APP_ID=""
TOUTIAO_APP_SECRET=""
